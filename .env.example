# Email Alert Notification Settings
SAFETYEYE_SMTP_SERVER=smtp.gmail.com
SAFETYEYE_SMTP_PORT=587
SAFETYEYE_SENDER_EMAIL=your_email@gmail.com
SAFETYEYE_SENDER_PASSWORD=your_app_password
SAFETYEYE_RECEIVER_EMAILS=safety_officer@company.com,manager@company.com

# Minimum cooldown between email alerts in seconds (default: 60 = 1 minute)
SAFETYEYE_EMAIL_COOLDOWN=60
